{
  "name": "phonenap",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.26",
    "expo-application": "~58.1.2",
    "expo-clipboard": "~58.0.4",
    "expo-dev-client": "~58.0.21",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-secure-store": "~58.0.3",
    "expo-speech": "~58.0.4",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas:check": "node ./scripts/verify-eas-config.mjs",
    "eas:check:strict": "node ./scripts/verify-eas-config.mjs --strict",
    "eas:build:ios": "npx eas-cli@latest build --platform ios --profile production",
    "eas:build:android": "npx eas-cli@latest build --platform android --profile production",
    "eas:submit:ios": "npx eas-cli@latest submit --platform ios --profile production",
    "eas:submit:android": "npx eas-cli@latest submit --platform android --profile production"
  },
  "private": true
}
